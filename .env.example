# ============================================================================
# CYBER QUEST — NEXUS: THE LAST CHANCE
# Example Configuration Reference (DO NOT COMMIT ACTUAL SECRETS)
# ============================================================================

# 1. Public Frontend Configuration (Set in js/config.js)
# Only the public project URL and public anon/publishable key belong in js/config.js.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLIC_ANON_KEY

# 2. Server-Side Secrets (Configured automatically inside Supabase Edge Functions)
# NEVER place SUPABASE_SERVICE_ROLE_KEY or database passwords in frontend files!
# Supabase injects SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY into Edge Functions
# automatically at runtime.
